{
  "name": "superpi-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Relay, account, presence and shared memory server for SuperPI devices",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server/index.ts",
    "start": "node src/server/index.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@superpi/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
