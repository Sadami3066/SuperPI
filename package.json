{
  "name": "superpi",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "SuperPI ecosystem workspace (Desktop, Relay, and Protocol)",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build:desktop": "pnpm --filter @superpi/desktop build",
    "dev:desktop": "pnpm --filter @superpi/desktop start",
    "dev:relay": "pnpm --filter @superpi/relay dev",
    "check:ts": "pnpm typecheck && pnpm test && pnpm build:desktop"
  }
}
