{
  "name": "superpi",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "description": "SuperPI ecosystem workspace (Relay, Web UI, Desktop, and Protocol)",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:relay": "pnpm --filter @superpi/relay dev",
    "dev:web": "pnpm --filter @superpi/web dev",
    "dev:desktop": "pnpm --filter @superpi/desktop dev",
    "build:web": "pnpm --filter @superpi/web build",
    "build:desktop": "pnpm --filter @superpi/desktop build",
    "check:ts": "pnpm typecheck && pnpm test"
  }
}
